{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kladdy",
  "version": "1.1.2",
  "identifier": "de.kladdy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kladdy",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 27
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1REQ1MUI4OTAwNUY3QjEKUldTeDl3V1F1RkhkdFNJMENOK1VjU1VHZWI3YWNtbzVtOEJiVlJWL2tDTm5JMDdDcGNMcWRKdGsK",
      "endpoints": [
        "https://github.com/m0cki/Kladdy/releases/latest/download/latest.json"
      ]
    }
  }
}
